# systemd-Unit für das fsrfb4aas-Backend. Auf dem Server nach
#   /etc/systemd/system/fsrfb4aas.service
# kopieren, dann:  sudo systemctl daemon-reload && sudo systemctl enable fsrfb4aas
#
# Läuft als eigener, unprivilegierter Nutzer `fsrfb4aas`. Geheimnisse kommen
# ausschließlich aus /etc/fsrfb4aas/fsrfb4aas.env (SEC-N-110, ADR 0017) — siehe
# deploy/fsrfb4aas.env.example. Kestrel bindet nur an localhost; TLS und
# öffentliche Erreichbarkeit macht der nginx-Reverse-Proxy (deploy/nginx-fsrfb4aas.conf).

[Unit]
Description=fsrfb4aas Backend (ASP.NET Core)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=fsrfb4aas
Group=fsrfb4aas
WorkingDirectory=/var/www/fsrfb4aas
ExecStart=/usr/bin/dotnet /var/www/fsrfb4aas/Fb4.Backend.dll
EnvironmentFile=/etc/fsrfb4aas/fsrfb4aas.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5100
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Hinter dem nginx-Reverse-Proxy: X-Forwarded-For / X-Forwarded-Proto auswerten
# (loopback als vertrauenswürdiger Proxy). Ohne Codeänderung über den Schalter.
Environment=ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# DataProtection-Schlüssel dauerhaft ablegen (sonst Warnung + neue Schlüssel je Neustart).
# HOME/DOTNET_CLI_HOME auf ein beschreibbares Verzeichnis, da der Nutzer kein Home hat.
Environment=XDG_DATA_HOME=/var/lib/fsrfb4aas
Environment=HOME=/var/lib/fsrfb4aas
Environment=DOTNET_CLI_HOME=/var/lib/fsrfb4aas
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=fsrfb4aas

# Härtung — der Dienst schreibt nur nach /var/lib/fsrfb4aas und /var/log/fsrfb4aas
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/fsrfb4aas /var/log/fsrfb4aas

[Install]
WantedBy=multi-user.target
