# Vorlage für /etc/fb4/fb4.env auf dem Server.
#
#   sudo install -m 600 -o root -g fb4 fb4.env.example /etc/fb4/fb4.env
#   sudo nano /etc/fb4/fb4.env      # Werte eintragen
#
# Format: KEY=VALUE je Zeile, keine Anführungszeichen, kein `export`.
# .NET liest verschachtelte Konfiguration über `__` (doppelter Unterstrich).
# Alle echten Werte stammen aus dem Vaultwarden-Depot und werden beim
# jährlichen FSR-Technik-Wechsel rotiert (ADR 0017, API-N-190).

# --- PostgreSQL (siehe deploy/README.md, Abschnitt "Datenbank einrichten") ---
ConnectionStrings__Fb4=Host=localhost;Port=5432;Database=fb4;Username=fb4;Password=CHANGEME

# --- Authentik / OIDC (INT-012, ADR 0010) ---
Authentik__Authority=https://auth.tobtech.de/application/o/fb4-app/
Authentik__Audience=fb4-app
Authentik__RedaktionGruppe=FSR-Redaktion
Authentik__ModerationGruppe=Moderation
# Verwaltungs-API für den Rollenwechsel (ADMIN-F-070). Weglassen => Rollenpflege
# meldet sich als nicht verfügbar (503), der Rest des Backends läuft normal.
Authentik__ManagementApiBaseUrl=https://auth.tobtech.de/api/v3/
Authentik__ManagementApiToken=CHANGEME

# --- Optional ---
# Mensa-Speiseplanquelle (INT-015); nur setzen, wenn vom Standard abweichend.
# Itmc__BaseUrl=https://mobil.itmc.tu-dortmund.de/canteen-menu/v3/
