# WhatsApp-Mining: Rohexporte und generierte/abgeleitete Daten, nie committen
# (enthalten reale Handynummern/Namen bzw. daraus abgeleitete Wortlaut-Auszuege).
# Liegen seit ADR 0020 nur noch lokal, siehe dort.
/analysis/
/chats/

# Quellcode beider Alt-Apps inkl. Dump von app.fsrfb4.de (enthielt Live-Zugangsdaten
# zum Admin-Bereich). Liegen seit ADR 0020 nur noch lokal, siehe dort.
/alte apps/

# Python
__pycache__/
*.pyc

# Node / JavaScript
node_modules/
*.tsbuildinfo
npm-debug.log*

# Expo (app/)
app/.expo/
app/dist/
app/dist-web/
app/dist-android/
app/web-build/
app/expo-env.d.ts

# Web-Export der Verwaltungsoberfläche, vom Backend mitausgeliefert (ADR 0018) —
# entsteht im Build, nie committen
backend/src/Fb4.Backend/wwwroot/admin/

# .NET (backend/)
[Bb]in/
[Oo]bj/
*.user

# Lokale Backend-Konfiguration mit Geheimnissen (Verbindungszeichenfolge,
# Authentik-Token) — nie committen. Die produktiven Werte kommen im Betrieb
# aus Umgebungsvariablen/Secrets (SEC-N-110).
appsettings.Development.json
appsettings.Local.json

# Server-Umgebungsdatei, falls lokal aus deploy/fsrfb4aas.env.example erzeugt — die
# echten Werte leben nur auf dem Server (/etc/fsrfb4aas/fsrfb4aas.env) und im Vaultwarden-Depot
deploy/fsrfb4aas.env

# Erzeugter Code aus dem Vertrag (tools/contract-codegen)
app/src/api/generated/
backend/src/Fb4.Backend/Contract/Generated/

# Lokal erzeugter Android-Upload-Keystore (Android-Testbuild-Direktdownload) —
# lebt nur im Vaultwarden-Depot des FSR-Vorstands und als GitHub-Secret,
# nie im Repo (SEC-F-040, openspec/changes/android-testbuild-download)
*.keystore
*.jks

# Editoren / OS
.DS_Store
.idea/
.vs/
