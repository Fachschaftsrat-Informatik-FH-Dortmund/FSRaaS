<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/stundenplan">

        <CheckBoxPreference
            android:defaultValue="@bool/preference_default_hide_empty_pages"
            android:key="@string/preference_key_hide_empty_pages"
            android:summary="@string/Pref_Stdp_Ausblenden_Sum"
            android:title="@string/Pref_Stdp_Ausblenden_Title">
        </CheckBoxPreference>

        <Preference
            android:key="@string/preference_key_delete_timetable"
            android:summary="@string/stundenplanLöschen_beschreibung"
            android:title="@string/stundenplanLöschen">
        </Preference>

        <Preference
            android:key="@string/preference_key_backup_timetable"
            android:summary="@string/stundenplanSichern_beschreibung"
            android:title="@string/stundenplanSichern">
        </Preference>

        <Preference
            android:key="@string/preference_key_restore_timetable"
            android:summary="@string/stundenplanWiederherstellen_beschreibung"
            android:title="@string/stundenplanWiederherstellen">
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/speiseplan">
        <Preference
            android:key="@string/preference_key_menus"
            android:summary="@string/speisepläne_beschreibung"
            android:title="@string/speisepläne">
        </Preference>

        <Preference
            android:key="@string/preference_key_menus_sort"
            android:summary="@string/speisepläneSortieren_beschreibung"
            android:title="@string/speisepläneSortieren">
        </Preference>

        <CheckBoxPreference
            android:defaultValue="@bool/preference_default_menu_gray"
            android:key="@string/preference_key_menu_gray"
            android:summary="@string/geschlRestaurantsMarkieren_beschreibung"
            android:title="@string/geschlRestaurantsMarkieren">
        </CheckBoxPreference>

        <ListPreference
            android:defaultValue="@string/preference_default_menu_price"
            android:dialogTitle="@string/showPricesFor"
            android:entries="@array/menu_price_items"
            android:entryValues="@array/menu_price_values"
            android:key="@string/preference_key_menu_price"
            android:persistent="true"
            android:summary="%s"
            android:title="@string/showPricesFor"/>
    </PreferenceCategory>

