    <PreferenceCategory android:title="@string/sonstiges">
        <CheckBoxPreference
            android:defaultValue="@bool/preference_default_news_notifications"
            android:key="@string/preference_key_news_notifications"
            android:persistent="true"
            android:summary="@string/Pref_Notif_Sum"
            android:title="@string/Pref_Notif_Title">
        </CheckBoxPreference>

        <ListPreference
            android:defaultValue="@string/preference_default_launch_screen"
            android:dialogTitle="@string/Pref_Start_Title"
            android:entries="@array/start_items"
            android:entryValues="@array/start_values"
            android:key="@string/preference_key_launch_screen"
            android:persistent="true"
            android:summary="@string/Pref_Start_Sum"
            android:title="@string/Pref_Start_Title"/>

        <ListPreference
            android:defaultValue="@string/preference_default_theme"
            android:dialogTitle="@string/thema_wählen"
            android:entries="@array/theme_items"
            android:entryValues="@array/theme_values"
            android:key="@string/preference_key_theme"
            android:persistent="true"
            android:title="@string/thema_wählen"/>

        <CheckBoxPreference
            android:defaultValue="@bool/preference_default_send_crash_reports"
            android:key="@string/preference_key_send_crash_reports"
            android:summary="@string/fehlerberichtSenden_beschreibung"
            android:title="@string/fehlerberichtSenden">
