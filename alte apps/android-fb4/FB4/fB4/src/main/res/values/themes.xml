<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FB4" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/main</item>
        <item name="colorPrimaryDark">@color/main_darker</item>
        <item name="colorAccent">@color/main_accent</item>

        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>

    <style name="Theme.FB4_2" parent="Theme.FB4">
        <item name="android:textColorSecondary">?attr/android:textColorPrimary</item>
        <item name="android:textColorSecondaryNoDisable">?attr/android:textColorPrimaryNoDisable</item>
        <item name="android:textColorSecondaryInverse">?attr/android:textColorPrimaryInverse</item>
        <item name="android:textColorSecondaryInverseNoDisable">?attr/android:textColorPrimaryInverseNoDisable</item>
        <item name="android:textColorTertiary">?attr/android:textColorSecondary</item>
        <item name="android:textColorTertiaryInverse">?attr/android:textColorSecondaryInverse</item>
    </style>

    <style name="SplashTheme" parent="Theme.FB4_2">
        <item name="android:windowBackground">@drawable/background_splash</item>
    </style>

    <style name="DialogTheme" parent="Theme.AppCompat.DayNight.Dialog">

    </style>

</resources>
