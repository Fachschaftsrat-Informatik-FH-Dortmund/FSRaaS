{
  "expo": {
    "name": "FSR Informatik",
    "slug": "fb4-app",
    "scheme": "fb4",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "baseUrl": "/admin"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.fsrfb4.app",
      "deploymentTarget": "15.1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "de.fsrfb4.app",
      "versionCode": 1.1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-localization",
      "expo-asset",
      "expo-router",
      "expo-quick-actions",
      "expo-secure-store",
      "./plugins/withNotifeeMaven",
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ]
    ],
    "extra": {
      "comment": "Vertrieb, Ziel-API-Stufen und F-Droid-Recipe: Roadmap Schritt 10, NFR Abschnitt 9. expo-updates und EAS bewusst nicht konfiguriert (ADR 0009).",
      "apiBaseUrl": "https://api.fb4.it/v1",
      "authIssuer": "https://auth.tobtech.de/application/o/fb4-app/",
      "authClientId": "fb4-app"
    }
  }
}
